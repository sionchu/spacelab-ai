# Server-side VWorld API key used by Next.js route handlers.
VWORLD_API_KEY=

# Optional exact VWorld service-domain allowlist value.
VWORLD_DOMAIN=

# Optional DEM TileJSON override. Defaults to MapLibre demo terrain.
NEXT_PUBLIC_DEM_TILEJSON=https://demotiles.maplibre.org/terrain-tiles/tiles.json

# Optional context-building search radius in meters.
NEXT_PUBLIC_BUILDING_CONTEXT_RADIUS_M=350


# Building context provider: auto | vworld | osm
# auto tries VWorld GIS building data first and falls back to OSM.
SPACELAB_BUILDING_PROVIDER=auto
