# VWorld WebGL 3D API 3.0 key.
# This is injected at build time and is used by the browser-side VWorld SDK.
# Restrict the key to the final Sites domain in VWorld console.
VITE_VWORLD_API_KEY=

# Optional VWorld service-domain allowlist value. For local work use localhost;
# for Sites builds use the exact deployed Site host.
VITE_VWORLD_DOMAIN=localhost


# Optional server-side Concept View image-generation endpoint.
# Never put an OpenAI/provider API key in VITE_* variables or browser code.
# Expected contract: POST multipart/form-data with metadata, prompt, referenceImage.
VITE_CONCEPT_VIEW_ENDPOINT=
