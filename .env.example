# Server-only VWorld key. Used by Next.js Route Handlers.
VWORLD_API_KEY=
VWORLD_DOMAIN=localhost

# Optional MOIS SafeMap key for official children's playground registry (IF_0007).
# When configured, PlaySafe merges operating outdoor urban-park / housing-complex
# playgrounds with OSM and VWorld candidates.
SAFEMAP_API_KEY=

# Optional public map configuration can be added later.
# Never expose provider secrets through NEXT_PUBLIC_* variables.


# Server-only Concept View image generation.
# Never expose this key through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
